<div class="booking-widget-wrap" id="booking-widget">
  <div class="booking-widget-inner">
    <div class="kross-container"></div>
  </div>
</div>

<style>
  .booking-widget-wrap {
    position: relative;
    z-index: 10;
    margin-top: -3rem;
    padding: 0 var(--sp-6);
    max-width: var(--maxw);
    margin-left: auto;
    margin-right: auto;
  }

  .booking-widget-inner {
    background: var(--paper);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* ── Mobile: no overlap, full width ── */
  @media (max-width: 768px) {
    .booking-widget-wrap {
      margin-top: 0;
      padding: 0;
      max-width: 100%;
    }
    .booking-widget-inner {
      border-radius: 0;
      box-shadow: var(--shadow-md);
    }
  }
</style>

<!-- Global overrides for KrossBooking (jQuery-injected, calendar appended to body) -->
<style is:global>
  /* ── Form inline widget (inside #booking-widget) ── */
  #booking-widget .kb-btn-submit,
  #kb-widget-container .kb-btn-submit {
    background-color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
    color: var(--paper) !important;
    border-radius: var(--r-md) !important;
    transition: background-color 180ms ease;
  }
  #booking-widget .kb-btn-submit:hover,
  #kb-widget-container .kb-btn-submit:hover {
    background-color: var(--terracotta-deep) !important;
    border-color: var(--terracotta-deep) !important;
  }
  /* Date dashes / guest count numbers */
  #booking-widget .kb-d,
  #booking-widget .kb-qt,
  #booking-widget .kb-qt-m {
    color: var(--terracotta) !important;
  }

  /* ──────────────────────────────────────────────────────────
     #kb-widget-container — popup appended to <body>
     ────────────────────────────────────────────────────────── */

  /* Month label (e.g. "giu 2026") */
  #kb-widget-container .daterangepicker th.month,
  #kb-widget-container .KB-daterangepicker th.month {
    color: var(--terracotta) !important;
  }

  /* Today */
  #kb-widget-container .daterangepicker td.today,
  #kb-widget-container .KB-daterangepicker td.today {
    color: var(--terracotta) !important;
    font-weight: 600;
  }

  /* Selected dates (start, end, single active) */
  #kb-widget-container .daterangepicker td.active,
  #kb-widget-container .daterangepicker td.active:hover,
  #kb-widget-container .daterangepicker td.start-date,
  #kb-widget-container .daterangepicker td.end-date,
  #kb-widget-container .KB-daterangepicker td.active,
  #kb-widget-container .KB-daterangepicker td.start-date,
  #kb-widget-container .KB-daterangepicker td.end-date {
    background-color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
    color: var(--paper) !important;
  }

  /* In-range days (between start and end) */
  #kb-widget-container .daterangepicker td.in-range:not(.active):not(.start-date):not(.end-date),
  #kb-widget-container .KB-daterangepicker td.in-range:not(.active):not(.start-date):not(.end-date) {
    background-color: rgba(184, 107, 74, 0.18) !important;
    color: var(--terracotta-deep) !important;
  }

  /* Hover on available days */
  #kb-widget-container .daterangepicker td.available:hover,
  #kb-widget-container .KB-daterangepicker td.available:hover {
    background-color: rgba(184, 107, 74, 0.28) !important;
    color: var(--terracotta-deep) !important;
  }

  /* Next/prev arrows */
  #kb-widget-container .kb-next span,
  #kb-widget-container .kb-prev span,
  #kb-widget-container th.prev,
  #kb-widget-container th.next {
    color: var(--terracotta) !important;
  }
  #kb-widget-container .kb-next span::before,
  #kb-widget-container .kb-prev span::before,
  #kb-widget-container th.prev::before,
  #kb-widget-container th.next::before {
    border-color: var(--terracotta) !important;
  }

  /* Apply / Cancel buttons */
  #kb-widget-container .applyBtn,
  #kb-widget-container .btn-primary {
    background-color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
    color: var(--paper) !important;
    border-radius: var(--r-md) !important;
  }
  #kb-widget-container .applyBtn:hover,
  #kb-widget-container .btn-primary:hover {
    background-color: var(--terracotta-deep) !important;
    border-color: var(--terracotta-deep) !important;
  }
  #kb-widget-container .cancelBtn,
  #kb-widget-container .btn-default {
    color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
    background-color: transparent !important;
    border-radius: var(--r-md) !important;
  }

  /* Reset / Done text actions */
  #kb-widget-container .kb-reset,
  #kb-widget-container .kb-btn-done,
  #kb-widget-container .drp-selected {
    color: var(--terracotta) !important;
  }

  /* Guests popup +/- buttons */
  #kb-widget-container .kb-btn-p {
    color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
  }
  #kb-widget-container .kb-qt-m {
    color: var(--terracotta) !important;
  }

  /* Mobile full-screen submit button */
  #kb-widget-container .kb-mobile-full-availability .kb-btn-submit {
    background-color: var(--terracotta) !important;
    border-color: var(--terracotta) !important;
    border-radius: var(--r-md) !important;
  }
</style>
