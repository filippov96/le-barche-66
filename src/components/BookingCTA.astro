---
import type { T } from '../i18n/index';
interface Props { t: T; }
const { t } = Astro.props;
---
<section class="booking-cta" id="booking" data-screen-label="08 Booking">
  <div class="wrap">
    <div class="booking-inner">
      <div>
        <h2 class="h2">
          {t.booking.title_a} <em class="italic" style="font-weight:300">{t.booking.title_b}</em>
        </h2>
        <p class="lede booking-cta-sub">{t.booking.sub}</p>
      </div>
      <div class="booking-info-grid">
        <div class="booking-info-block">
          <div class="booking-info-title">{t.booking.checkin_title}</div>
          <ul class="booking-info-list">
            <li>{t.booking.checkin_from}</li>
            <li>{t.booking.checkin_late}</li>
            <li>{t.booking.checkout}</li>
          </ul>
        </div>
        <div class="booking-info-block">
          <div class="booking-info-title">{t.booking.cancel_title}</div>
          <ul class="booking-info-list">
            <li>{t.booking.cancel_prepaid}</li>
            <li>{t.booking.cancel_standard}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .booking-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
  }
  .booking-info-title {
    font-size: var(--fs-xs, 11px);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: var(--sp-3);
  }
  .booking-info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .booking-info-list li {
    font-size: var(--fs-sm, 14px);
    opacity: 0.75;
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .booking-info-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }
</style>
