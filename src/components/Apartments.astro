---
import type { T } from '../i18n/index';
import { BOOKING_URL } from '../i18n/index';
import Icon from './Icon.astro';
interface Props { t: T; }
const { t } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const APT_PHOTOS = [
  { avif: `${BASE}/photos/apt-3-main.avif`,  jpg: `${BASE}/photos/apt-3-main.jpg`  },
  { avif: `${BASE}/photos/apt-3a-2.avif`,    jpg: `${BASE}/photos/apt-3a-2.jpg`    },
  { avif: `${BASE}/photos/apt-3b-2.avif`,    jpg: `${BASE}/photos/apt-3b-2.jpg`    },
  { avif: `${BASE}/photos/apt-3c-2.avif`,    jpg: `${BASE}/photos/apt-3c-2.jpg`    },
  { avif: `${BASE}/photos/apt-3d-main.avif`, jpg: `${BASE}/photos/apt-3d-main.jpg` },
];
// Plans: 2A→3, 2B→3A, 2C→3B, 2D→3C, 2E→3D
const APT_PLANS = [
  { avif: `${BASE}/photos/plans/plan-3.avif`,  webp: `${BASE}/photos/plans/plan-3.webp`  },
  { avif: `${BASE}/photos/plans/plan-3A.avif`, webp: `${BASE}/photos/plans/plan-3A.webp` },
  { avif: `${BASE}/photos/plans/plan-3B.avif`, webp: `${BASE}/photos/plans/plan-3B.webp` },
  { avif: `${BASE}/photos/plans/plan-3C.avif`, webp: `${BASE}/photos/plans/plan-3C.webp` },
  { avif: `${BASE}/photos/plans/plan-3D.avif`, webp: `${BASE}/photos/plans/plan-3D.webp` },
];
---
<section class="section" id="apartments" data-screen-label="04 Apartments">
  <div class="wrap">
    <div class="apartments-head">
      <div>
        <span class="eyebrow">{t.apartments.eyebrow}</span>
        <h2 class="h2" style="margin-top:16px">{t.apartments.title}</h2>
      </div>
      <p class="lede">{t.apartments.sub}</p>
    </div>
    <div class="apt-list">
      {t.apartments.list.map(([num, name, desc, capacity, size], i) => (
        <div
          class="apt-row"
          data-index={i}
          data-plan-avif={APT_PLANS[i].avif}
          data-plan-webp={APT_PLANS[i].webp}
          data-plan-label={`Apt ${num} — ${name}`}
          role="button"
          tabindex="0"
          aria-label={`Apt ${num} ${name} — ${t.apartments.view_plan}`}
        >
          <div class="apt-num">{num}</div>
          <div class="apt-name-block">
            <div class="apt-num-label">Apt {num}</div>
            <div class="apt-name">{name}</div>
          </div>
          <div class="apt-desc">{desc}</div>
          <div class="apt-meta apt-meta-1"><Icon name="users" size={14}/><span><strong>{capacity}</strong></span></div>
          <div class="apt-meta apt-meta-2"><Icon name="ruler" size={14}/><span><strong>{size}</strong></span></div>
          <button type="button" class="apt-cta" aria-label={t.apartments.view_plan}><Icon name="arrow-up-right" size={16}/></button>
          <!-- Mobile photo -->
          <div class="apt-photo-wrap">
            <picture>
              {APT_PHOTOS[i].avif && <source srcset={APT_PHOTOS[i].avif} type="image/avif" />}
              <img src={APT_PHOTOS[i].jpg} alt={name} class="apt-photo-img" loading="lazy" decoding="async" />
            </picture>
            <div class="apt-photo-bar">
              <span class="apt-tag">
                <Icon name="users" size={13}/>{capacity}<span class="apt-tag-sep">·</span><Icon name="ruler" size={13}/>{size}
              </span>
              <button type="button" class="btn btn-primary apt-book-btn apt-view-plan-btn">{t.apartments.view_plan}</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Final CTA -->
    <div class="apt-final-cta">
      <div class="apt-final-cta-text">
        <h3 class="h3">{t.apartments.cta_title}</h3>
        <p>{t.apartments.cta_sub}</p>
      </div>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn btn-primary btn-arrow">
        {t.apartments.cta_button}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <!-- Desktop hover preview -->
  <div class="apt-hover-preview" id="apt-hover-preview">
    <img id="apt-preview-img" src="" alt="" />
    <div class="apt-preview-tag" id="apt-preview-tag"></div>
  </div>

  <!-- Plan modal -->
  <div class="apt-modal" id="apt-modal" role="dialog" aria-modal="true" aria-labelledby="apt-modal-label" hidden>
    <div class="apt-modal-backdrop" data-close></div>
    <div class="apt-modal-panel">
      <button type="button" class="apt-modal-close" aria-label={t.apartments.close} data-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <div class="apt-modal-label" id="apt-modal-label"></div>
      <picture class="apt-modal-picture">
        <source id="apt-modal-avif" type="image/avif" />
        <img id="apt-modal-img" src="" alt={t.apartments.plan_alt} />
      </picture>
    </div>
  </div>
</section>

<style>
  .apt-final-cta {
    margin-top: var(--sp-8);
    padding: var(--sp-7) var(--sp-7);
    background: var(--bg-deep);
    color: var(--paper);
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }
  .apt-final-cta .h3 {
    color: var(--paper);
    margin: 0 0 var(--sp-2);
  }
  .apt-final-cta p {
    margin: 0;
    opacity: 0.78;
    font-size: var(--fs-lede);
  }
  @media (max-width: 640px) {
    .apt-final-cta {
      padding: var(--sp-6) var(--sp-5);
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-5);
    }
    .apt-final-cta .btn { width: 100%; justify-content: center; }
  }

  .apt-row { cursor: pointer; }

  /* Plan modal */
  .apt-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4);
  }
  .apt-modal[hidden] { display: none !important; }
  .apt-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 41, 53, 0.72);
    backdrop-filter: blur(0.5rem);
    -webkit-backdrop-filter: blur(0.5rem);
    animation: aptModalFade 200ms ease forwards;
  }
  .apt-modal-panel {
    position: relative;
    z-index: 1;
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
    max-width: min(80rem, 96vw);
    max-height: 92vh;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    animation: aptModalPop 240ms cubic-bezier(.2,.7,.2,1) forwards;
  }
  .apt-modal-label {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--ink);
    font-weight: 400;
    margin-bottom: var(--sp-4);
    padding-right: var(--sp-7);
  }
  .apt-modal-close {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: var(--stone-2);
    border-radius: 50%;
    cursor: pointer;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 180ms ease;
  }
  .apt-modal-close:hover { background: var(--bone); }
  .apt-modal-picture {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--stone);
    flex: 1;
    min-height: 0;
  }
  .apt-modal-picture img {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  @keyframes aptModalFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes aptModalPop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (max-width: 640px) {
    .apt-modal { padding: 0; }
    .apt-modal-panel {
      max-width: 100%;
      max-height: 100vh;
      width: 100%;
      height: 100%;
      border-radius: 0;
      padding: var(--sp-7) var(--sp-4) var(--sp-4);
    }
    .apt-modal-picture img { max-height: calc(100vh - 9rem); }
  }
</style>

<script>
  const preview = document.getElementById('apt-hover-preview') as HTMLElement;
  const previewImg = document.getElementById('apt-preview-img') as HTMLImageElement;
  const previewTag = document.getElementById('apt-preview-tag') as HTMLElement;

  const modal = document.getElementById('apt-modal') as HTMLElement;
  const modalImg = document.getElementById('apt-modal-img') as HTMLImageElement;
  const modalAvif = document.getElementById('apt-modal-avif') as HTMLSourceElement;
  const modalLabel = document.getElementById('apt-modal-label') as HTMLElement;

  const rows = document.querySelectorAll<HTMLElement>('.apt-row');

  document.addEventListener('mousemove', (e) => {
    if (preview) {
      preview.style.left = e.clientX + 'px';
      preview.style.top = e.clientY + 'px';
    }
  });

  function openModal(row: HTMLElement) {
    const avif = row.dataset.planAvif || '';
    const webp = row.dataset.planWebp || '';
    const label = row.dataset.planLabel || '';
    modalAvif.srcset = avif;
    modalImg.src = webp;
    modalLabel.textContent = label;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  modal.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close]')) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  rows.forEach((row) => {
    const img = row.querySelector('.apt-photo-img') as HTMLImageElement | null;
    const num = row.querySelector('.apt-num')?.textContent || '';
    const size = row.querySelector('.apt-meta-2 strong')?.textContent || '';

    // Desktop hover preview
    row.addEventListener('mouseenter', () => {
      if (img && previewImg) {
        const avifSrc = img.closest('picture')?.querySelector('source[type="image/avif"]')?.getAttribute('srcset');
        previewImg.src = avifSrc || img.src;
        previewImg.alt = img.alt;
      }
      if (previewTag) previewTag.textContent = `${num} · ${size}`;
      preview?.classList.add('visible');
    });
    row.addEventListener('mouseleave', () => {
      preview?.classList.remove('visible');
    });

    // Click anywhere on row (or mobile button) → open modal
    row.addEventListener('click', (event) => {
      // Allow internal anchors / external links to still work
      const link = (event.target as HTMLElement).closest('a');
      if (link && link.getAttribute('href') && !link.classList.contains('apt-view-plan-btn')) return;
      event.preventDefault();
      openModal(row);
    });
    row.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openModal(row);
    });
  });
</script>
